
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090612">
<title>SIP & SOCIAL | Meet. Connect. Socialize.</title>

<style>
:root {
  --bg:#090612;
  --panel:#171020;
  --panel2:#21132f;
  --purple:#963dff;
  --neon:#dc55ff;
  --white:#fff;
  --muted:#b5a9c2;
  --border:#38234d;
  --green:#54e6ad;
}

* {
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body {
  font-family:Arial,sans-serif;
  background:var(--bg);
  color:var(--white);
  line-height:1.5;
}

button,input,textarea,select {
  font:inherit;
}

button {
  cursor:pointer;
  border:0;
  border-radius:9px;
  padding:12px 18px;
  font-weight:bold;
}

.primary {
  color:white;
  background:linear-gradient(100deg,#8535ff,#d34fff);
}

.secondary {
  color:white;
  background:#29183b;
  border:1px solid var(--purple);
}

button:hover {
  filter:brightness(1.15);
}

input,textarea,select {
  width:100%;
  padding:13px;
  background:#100b19;
  border:1px solid var(--border);
  border-radius:8px;
  color:white;
  outline:none;
}

input:focus,textarea:focus,select:focus {
  border-color:var(--neon);
}

textarea {
  resize:vertical;
  min-height:85px;
}

a {
  color:inherit;
  text-decoration:none;
}

header {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:15px;
  padding:19px 6%;
  background:#0c0814;
  border-bottom:1px solid var(--border);
  position:sticky;
  top:0;
  z-index:10;
}

.logo {
  font-size:24px;
  font-weight:900;
  letter-spacing:2px;
  color:var(--neon);
  white-space:nowrap;
}

.logo span {
  color:white;
}

nav {
  display:flex;
  gap:22px;
}

nav a {
  font-size:14px;
  color:#e8dff0;
}

nav a:hover {
  color:var(--neon);
}

#accountArea {
  display:flex;
  align-items:center;
  gap:10px;
}

#accountArea button {
  padding:10px 14px;
}

.hero {
  min-height:510px;
  display:flex;
  align-items:center;
  padding:85px 8%;
  background:
    linear-gradient(90deg,rgba(9,6,18,.97),rgba(22,7,38,.6)),
    url("https://images.unsplash.com/photo-1517457373958-b7bdd4587205?w=1600")
    center/cover;
}

.hero-content {
  max-width:680px;
}

.hero h1 {
  font-size:clamp(42px,7vw,76px);
  line-height:1.08;
  margin-bottom:20px;
}

.hero h1 span {
  color:var(--neon);
}

.hero p {
  color:#d5c9e1;
  font-size:17px;
  line-height:1.8;
  margin-bottom:28px;
}

.hero-buttons {
  display:flex;
  flex-wrap:wrap;
  gap:12px;
}

section {
  padding:65px 7%;
}

.section-title {
  font-size:30px;
  margin-bottom:10px;
}

.section-subtitle {
  color:var(--muted);
  margin-bottom:28px;
}

.categories {
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-bottom:25px;
}

.category {
  background:var(--panel);
  color:white;
  border:1px solid var(--border);
  border-radius:25px;
}

.category.active {
  background:var(--purple);
}

.people-grid,.meetup-grid {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
  gap:22px;
}

.card {
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:15px;
  overflow:hidden;
  transition:.25s;
}

.card:hover {
  transform:translateY(-4px);
  border-color:var(--neon);
}

.profile-image {
  height:270px;
  width:100%;
  object-fit:cover;
  background:#241632;
}

.card-content {
  padding:18px;
}

.card-content h3 {
  margin-bottom:7px;
}

.card-content p {
  color:var(--muted);
  font-size:14px;
  margin:10px 0;
}

.distance {
  color:#d28bff;
  font-size:13px;
  margin:12px 0;
}

.tag {
  display:inline-block;
  background:#302044;
  color:#e1b5ff;
  padding:5px 10px;
  border-radius:20px;
  font-size:11px;
  margin:3px;
}

.card-actions {
  display:flex;
  gap:8px;
  margin-top:15px;
}

.card-actions button {
  flex:1;
  padding:10px;
  font-size:12px;
}

.meetup-card {
  padding:22px;
}

.meetup-card h3 {
  color:var(--neon);
  font-size:19px;
}

.meetup-info {
  color:var(--muted);
  font-size:14px;
  margin:15px 0;
  line-height:2;
  white-space:pre-line;
}

.meetup-card button {
  width:100%;
  margin-top:10px;
}

.create-section {
  background:linear-gradient(135deg,#170d28,#26103c);
  border-top:1px solid var(--border);
  border-bottom:1px solid var(--border);
}

.form-container {
  max-width:650px;
}

.form-grid {
  display:grid;
  gap:14px;
}

.form-grid label {
  font-size:13px;
  color:#e2d5ed;
  display:block;
  margin-bottom:7px;
}

.form-grid small {
  display:block;
  color:var(--muted);
  margin-top:5px;
}

.preview-image {
  width:100px;
  height:100px;
  object-fit:cover;
  border-radius:12px;
  border:1px solid var(--purple);
}

.photo-previews {
  display:flex;
  flex-wrap:wrap;
  gap:10px;
}

.feature-grid {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
  gap:18px;
}

.feature {
  background:var(--panel);
  border:1px solid var(--border);
  padding:24px;
  border-radius:14px;
}

.feature h3 {
  color:var(--neon);
  margin-bottom:10px;
}

.feature p {
  color:var(--muted);
  font-size:14px;
}

.empty {
  color:var(--muted);
  padding:30px 10px;
  text-align:center;
  grid-column:1/-1;
  background:var(--panel);
  border-radius:12px;
}

footer {
  padding:40px 20px;
  text-align:center;
  color:var(--muted);
  line-height:2;
}

.modal {
  display:none;
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.85);
  z-index:30;
  justify-content:center;
  align-items:center;
  padding:15px;
}

.modal-content {
  background:#171020;
  border:1px solid var(--purple);
  border-radius:15px;
  padding:27px;
  width:100%;
  max-width:470px;
  max-height:90vh;
  overflow-y:auto;
}

.modal-content h2 {
  color:var(--neon);
  margin-bottom:20px;
}

.modal-content input,
.modal-content textarea,
.modal-content select {
  margin-bottom:13px;
}

.close {
  float:right;
  color:white;
  background:transparent;
  font-size:25px;
  padding:0 5px;
}

.modal-content label {
  display:block;
  color:var(--muted);
  font-size:13px;
  margin-bottom:12px;
}

.inline-check {
  display:flex!important;
  align-items:center;
  gap:9px;
}

.inline-check input {
  width:auto;
  margin:0;
}

.modal-content button[type="submit"] {
  width:100%;
}

#notification {
  display:none;
  position:fixed;
  z-index:60;
  bottom:20px;
  left:50%;
  transform:translateX(-50%);
  padding:14px 20px;
  background:#29183b;
  border:1px solid var(--neon);
  border-radius:10px;
  max-width:90%;
  text-align:center;
}

.user-bar {
  display:flex;
  align-items:center;
  gap:10px;
}

.user-avatar {
  width:38px;
  height:38px;
  border-radius:50%;
  object-fit:cover;
}

#profileArea {
  display:none;
}

@media(max-width:750px) {
  header {
    flex-wrap:wrap;
    padding:15px 4%;
  }

  nav {
    order:3;
    width:100%;
    justify-content:space-around;
    gap:8px;
  }

  nav a {
    font-size:12px;
  }

  .hero {
    min-height:450px;
    padding:65px 6%;
  }

  section {
    padding:48px 5%;
  }

  .section-title {
    font-size:25px;
  }

  .people-grid,.meetup-grid {
    grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
  }
}

@media(max-width:420px) {
  .logo {
    font-size:19px;
  }

  .people-grid,.meetup-grid {
    grid-template-columns:1fr;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">SIP <span>&</span> SOCIAL</div>

  <nav>
    <a href="#discover">Discover</a>
    <a href="#meetups">Meetups</a>
    <a href="#create">Create</a>
    <a href="#safety">Safety</a>
  </nav>

  <div id="accountArea">
    <button class="primary" onclick="openModal('authModal')">
      Join / Login
    </button>
  </div>
</header>

<div class="hero">
  <div class="hero-content">
    <h1>Good Drinks.<br>Great People.<br><span>Better Connections.</span></h1>

    <p>
      Find people around you, discover new places,
      create social meetups and make meaningful connections.
      Never let a good evening go to waste.
    </p>

    <div class="hero-buttons">
      <button class="primary" onclick="goTo('discover')">
        Discover People
      </button>

      <button class="secondary" onclick="goTo('meetups')">
        Explore Meetups
      </button>
    </div>
  </div>
</div>

<section id="discover">
  <h2 class="section-title">Discover Your People ✨</h2>
  <p class="section-subtitle">
    Meet people with similar interests and social preferences.
  </p>

  <div class="categories">
    <button class="category active" onclick="filterPeople('All',this)">Everyone</button>
    <button class="category" onclick="filterPeople('Coffee',this)">Coffee</button>
    <button class="category" onclick="filterPeople('Party',this)">Social events</button>
    <button class="category" onclick="filterPeople('Chill',this)">Chill vibes</button>
    <button class="category" onclick="filterPeople('Adventure',this)">Adventure</button>
  </div>

  <div class="people-grid" id="peopleGrid"></div>
</section>

<section id="profileArea">
  <h2 class="section-title">My Profile 👤</h2>
  <p class="section-subtitle">Your SIP & SOCIAL account.</p>
  <div id="myProfile" class="card" style="max-width:550px"></div>
  <br>
  <button class="secondary" onclick="openModal('editModal')">Edit Profile</button>
  <button class="secondary" onclick="logout()">Log Out</button>
</section>

<section id="meetups">
  <h2 class="section-title">Upcoming Meetups 🥤</h2>
  <p class="section-subtitle">
    Choose a meetup, check the date and time, and RSVP.
  </p>

  <div class="meetup-grid" id="meetupGrid"></div>
</section>

<section class="create-section" id="create">
  <div class="form-container">
    <h2 class="section-title">Create a Meetup 🚀</h2>

    <p class="section-subtitle">
      Choose a public venue, date and time. Invite people to join.
    </p>

    <form class="form-grid" id="meetupForm">

      <div>
        <label>Meetup name</label>
        <input id="eventName" required placeholder="e.g. Friday Social">
      </div>

      <div>
        <label>Public venue</label>
        <input id="eventLocation" required placeholder="e.g. A named cafe, Westlands">
      </div>

      <div>
        <label>Date</label>
        <input id="eventDate" type="date" required>
      </div>

      <div>
        <label>Meeting time</label>
        <input id="eventTime" type="time" required>
      </div>

      <div>
        <label>Type of meetup</label>
        <select id="eventType" required>
          <option value="">Choose an activity</option>
          <option>Coffee meetup</option>
          <option>Juice and chill</option>
          <option>Mocktail evening</option>
          <option>Social gathering</option>
          <option>Music and dancing</option>
          <option>Games and conversations</option>
        </select>
      </div>

      <div>
        <label>Maximum attendees</label>
        <input id="eventCapacity" type="number" min="2" max="100" required value="10">
      </div>

      <div>
        <label>Describe your meetup</label>
        <textarea id="eventDescription" placeholder="What should people expect?"></textarea>
      </div>

      <button class="primary" type="submit">Publish Meetup</button>

    </form>
  </div>
</section>

<section id="safety">
  <h2 class="section-title">Your Safety Comes First 🛡️</h2>
  <p class="section-subtitle">
    Connections should be enjoyable, respectful and safe.
  </p>

  <div class="feature-grid">

    <div class="feature">
      <h3>18+ Community</h3>
      <p>Age-restricted membership with age verification planned before public launch.</p>
    </div>

    <div class="feature">
      <h3>Photo Profiles</h3>
      <p>Members can upload profile pictures to help others recognize them.</p>
    </div>

    <div class="feature">
      <h3>Private Locations</h3>
      <p>Neighbourhoods and approximate distances only. No public exact live locations.</p>
    </div>

    <div class="feature">
      <h3>Public Meetups</h3>
      <p>Meet in established public venues. Tell someone you trust about your plans.</p>
    </div>

    <div class="feature">
      <h3>Report & Block</h3>
      <p>Members should be able to report inappropriate conduct and block unwanted contact.</p>
    </div>

    <div class="feature">
      <h3>Respect Everyone</h3>
      <p>Everyone deserves respectful interactions and control over their personal information.</p>
    </div>

  </div>
</section>

<footer>
  <div class="logo">SIP & SOCIAL</div>
  Meet. Connect. Socialize.<br>
  © 2026 SIP & SOCIAL.<br>
  Non-alcoholic social activities in this demonstration.
</footer>

<!-- LOGIN AND REGISTRATION -->

<div class="modal" id="authModal">
  <div class="modal-content">
    <button class="close" onclick="closeModal('authModal')">×</button>

    <h2>Create Your Account</h2>

    <form id="registerForm">
      <input id="regName" placeholder="Display name" required>

      <input id="regEmail" type="email" placeholder="Email address" required>

      <input id="regPassword" type="password" placeholder="Create password" minlength="8" required>

      <input id="regAge" type="number" placeholder="Age (18+)" min="18" max="120" required>

      <input id="regCity" placeholder="City" required>

      <input id="regArea" placeholder="Neighbourhood (approximate)" required>

      <label class="inline-check">
        <input type="checkbox" id="regAdult" required>
        I confirm that I am 18 or older.
      </label>

      <label class="inline-check">
        <input type="checkbox" id="regAgree" required>
        I agree to the community rules and privacy policy.
      </label>

      <button type="submit" class="primary">Create Account</button>
    </form>

    <hr style="border-color:var(--border);margin:20px 0">

    <h3>Already have an account?</h3>

    <form id="loginForm">
      <input id="loginEmail" type="email" placeholder="Email address" required>
      <input id="loginPassword" type="password" placeholder="Password" required>
      <button type="submit" class="secondary">Login</button>
    </form>
  </div>
</div>

<!-- PROFILE CREATION -->

<div class="modal" id="editModal">
  <div class="modal-content">
    <button class="close" onclick="closeModal('editModal')">×</button>

    <h2>Edit Your Profile</h2>

    <form id="profileForm">

      <input id="editName" placeholder="Display name" required>

      <input id="editCity" placeholder="City" required>

      <input id="editArea" placeholder="Neighbourhood" required>

      <textarea id="editBio" placeholder="Tell people about yourself"></textarea>

      <select id="editInterest">
        <option>Coffee</option>
        <option>Party</option>
        <option>Chill</option>
        <option>Adventure</option>
      </select>

      <label>Upload profile photos (maximum 3)</label>
      <input id="editPhotos" type="file" accept="image/*" multiple>

      <div class="photo-previews" id="photoPreviews"></div>

      <button type="submit" class="primary">Save Profile</button>

    </form>
  </div>
</div>

<div id="notification"></div>

<script>

/* ==================================
   SIP & SOCIAL DEMONSTRATION APP
================================== */

const STORAGE = {
  users:"sip_social_users",
  current:"sip_social_current",
  meetups:"sip_social_meetups"
};

function load(key,fallback) {
  try {
    const value = localStorage.getItem(key);
    return value ? JSON.parse(value) : fallback;
  } catch {
    return fallback;
  }
}

function save(key,value) {
  try {
    localStorage.setItem(key,JSON.stringify(value));
    return true;
  } catch {
    notify("Storage limit reached. Try smaller photos.");
    return false;
  }
}

let users = load(STORAGE.users,[]);
let currentUser = load(STORAGE.current,null);

const today = new Date().toISOString().slice(0,10);

let meetups = load(STORAGE.meetups,[
  {
    id:"demo1",
    name:"Coffee & Conversations",
    location:"Public cafe, Kilimani",
    date:"2026-12-05",
    time:"14:00",
    type:"Coffee meetup",
    capacity:8,
    description:"Good conversations and new connections.",
    attendees:[],
    host:"SIP & SOCIAL"
  },
  {
    id:"demo2",
    name:"Mocktail Evening",
    location:"Public lounge, Westlands",
    date:"2026-12-06",
    time:"17:30",
    type:"Mocktail evening",
    capacity:12,
    description:"Relax and meet new people.",
    attendees:[],
    host:"SIP & SOCIAL"
  }
]);

/* NOTIFICATIONS */

function notify(message) {
  const box=document.getElementById("notification");
  box.textContent=message;
  box.style.display="block";

  clearTimeout(window.noticeTimer);

  window.noticeTimer=setTimeout(()=>{
    box.style.display="none";
  },3500);
}

function goTo(id) {
  document.getElementById(id).scrollIntoView({
    behavior:"smooth"
  });
}

function openModal(id) {
  document.getElementById(id).style.display="flex";
}

function closeModal(id) {
  document.getElementById(id).style.display="none";
}

function escapeHTML(value) {
  return String(value ?? "").replace(/[&<>"']/g,char=>({
    "&":"&amp;",
    "<":"&lt;",
    ">":"&gt;",
    '"':"&quot;",
    "'":"&#39;"
  })[char]);
}

/* ACCOUNT REGISTRATION */

document.getElementById("registerForm").addEventListener("submit",async function(e) {
  e.preventDefault();

  const age=Number(document.getElementById("regAge").value);

  if(age<18) {
    notify("Membership is restricted to adults aged 18+.");
    return;
  }

  const email=document.getElementById("regEmail").value.trim().toLowerCase();

  if(users.some(user=>user.email===email)) {
    notify("An account with this email already exists.");
    return;
  }

  const password=document.getElementById("regPassword").value;

  if(password.length<8) {
    notify("Password must contain at least 8 characters.");
    return;
  }

  const user={
    id:crypto.randomUUID(),
    name:document.getElementById("regName").value.trim(),
    email:email,
    password:password,
    age:age,
    city:document.getElementById("regCity").value.trim(),
    area:document.getElementById("regArea").value.trim(),
    bio:"",
    interest:"Coffee",
    photos:[],
    blocked:[],
    created:new Date().toISOString()
  };

  users.push(user);

  if(!save(STORAGE.users,users)) {
    users.pop();
    return;
  }

  currentUser=user;

  save(STORAGE.current,user);

  closeModal("authModal");
  this.reset();

  refresh();
  notify("Welcome to SIP & SOCIAL!");
});

/* LOGIN */

document.getElementById("loginForm").addEventListener("submit",function(e) {
  e.preventDefault();

  const email=document.getElementById("loginEmail").value.trim().toLowerCase();
  const password=document.getElementById("loginPassword").value;

  const user=users.find(u=>u.email===email && u.password===password);

  if(!user) {
    notify("Incorrect email or password.");
    return;
  }

  if(user.age<18) {
    notify("Membership is restricted to adults aged 18+.");
    return;
  }

  currentUser=user;

  save(STORAGE.current,user);

  closeModal("authModal");
  this.reset();

  refresh();
  notify("Welcome back, "+user.name+"!");
});

/* LOGOUT */

function logout() {
  currentUser=null;
  localStorage.removeItem(STORAGE.current);

  refresh();
  notify("You have logged out.");
}

/* PHOTO UPLOAD */

async function compressPhoto(file) {
  if(!file.type.startsWith("image/")) {
    throw new Error("Invalid image.");
  }

  if(file.size>8*1024*1024) {
    throw new Error("Choose photos smaller than 8 MB.");
  }

  return new Promise((resolve,reject)=>{
    const reader=new FileReader();

    reader.onload=()=>{
      const img=new Image();

      img.onload=()=>{
        const canvas=document.createElement("canvas");

        const max=900;
        const scale=Math.min(1,max/Math.max(img.width,img.height));

        canvas.width=Math.round(img.width*scale);
        canvas.height=Math.round(img.height*scale);

        const ctx=canvas.getContext("2d");

        ctx.drawImage(img,0,0,canvas.width,canvas.height);

        resolve(canvas.toDataURL("image/jpeg",0.75));
      };

      img.onerror=reject;
      img.src=reader.result;
    };

    reader.onerror=reject;
    reader.readAsDataURL(file);
  });
}

/* EDIT PROFILE */

function openProfileEditor() {
  if(!currentUser) {
    openModal("authModal");
    return;
  }

  document.getElementById("editName").value=currentUser.name;
  document.getElementById("editCity").value=currentUser.city;
  document.getElementById("editArea").value=currentUser.area;
  document.getElementById("editBio").value=currentUser.bio||"";
  document.getElementById("editInterest").value=currentUser.interest||"Coffee";

  renderPreviews();

  openModal("editModal");
}

function renderPreviews() {
  const container=document.getElementById("photoPreviews");

  container.innerHTML="";

  (currentUser.photos||[]).forEach(photo=>{
    const img=document.createElement("img");
    img.src=photo;
    img.className="preview-image";
    container.appendChild(img);
  });
}

document.getElementById("profileForm").addEventListener("submit",async function(e) {
  e.preventDefault();

  if(!currentUser) return;

  const files=Array.from(document.getElementById("editPhotos").files);

  if((currentUser.photos.length+files.length)>3) {
    notify("You can upload a maximum of 3 photos.");
    return;
  }

  let newPhotos=[];

  try {
    for(const file of files) {
      newPhotos.push(await compressPhoto(file));
    }
  } catch(error) {
    notify(error.message||"Could not upload photos.");
    return;
  }

  const updated={
    ...currentUser,
    name:document.getElementById("editName").value.trim(),
    city:document.getElementById("editCity").value.trim(),
    area:document.getElementById("editArea").value.trim(),
    bio:document.getElementById("editBio").value.trim(),
    interest:document.getElementById("editInterest").value,
    photos:[...(currentUser.photos||[]),...newPhotos]
  };

  const oldUsers=users;

  users=users.map(u=>u.id===updated.id?updated:u);

  if(!save(STORAGE.users,users)) {
    users=oldUsers;
    return;
  }

  currentUser=updated;
  save(STORAGE.current,currentUser);

  closeModal("editModal");
  this.reset();

  refresh();
  notify("Your profile has been updated!");
});

/* PROFILE DISPLAY */

function renderMyProfile() {
  const area=document.getElementById("myProfile");

  if(!currentUser) {
    area.innerHTML="";
    return;
  }

  const photo=currentUser.photos?.[0]||"https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=600";

  area.innerHTML=`
    <img class="profile-image" src="${photo}">
    <div class="card-content">
      <h3>${escapeHTML(currentUser.name)}, ${currentUser.age}</h3>
      <p>${escapeHTML(currentUser.bio)}</p>
      <p>📍 ${escapeHTML(currentUser.area)}, ${escapeHTML(currentUser.city)}</p>
      <span class="tag">${escapeHTML(currentUser.interest)}</span>
      <p>${currentUser.photos?.length||0} profile photos uploaded</p>
    </div>
  `;
}

/* SAMPLE DISCOVERY PROFILES */

const samplePeople=[
  {
    id:"sample1",
    name:"Alex",
    age:24,
    city:"Nairobi",
    area:"Westlands",
    distance:"1.2 km away",
    interest:"Coffee",
    bio:"Coffee lover, music and good conversations.",
    photo:"https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=600"
  },
  {
    id:"sample2",
    name:"Maya",
    age:23,
    city:"Nairobi",
    area:"Kilimani",
    distance:"2.5 km away",
    interest:"Party",
    bio:"Love discovering new places and meeting people.",
    photo:"https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=600"
  },
  {
    id:"sample3",
    name:"Daniel",
    age:26,
    city:"Nairobi",
    area:"Karen",
    distance:"3.1 km away",
    interest:"Adventure",
    bio:"Always ready for a new experience.",
    photo:"https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=600"
  },
  {
    id:"sample4",
    name:"Sophia",
    age:22,
    city:"Nairobi",
    area:"Lavington",
    distance:"4 km away",
    interest:"Chill",
    bio:"Mocktails, movies and relaxed evenings.",
    photo:"https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=600"
  }
];

function getPeople() {
  const registered=users
    .filter(u=>u.id!==currentUser?.id)
    .filter(u=>!currentUser?.blocked?.includes(u.id))
    .filter(u=>u.city.toLowerCase()===currentUser?.city?.toLowerCase())
    .map(u=>({
      ...u,
      distance:"Distance unavailable",
      photo:u.photos?.[0]||""
    }));

  const samples=samplePeople
    .filter(p=>!currentUser?.blocked?.includes(p.id))
    .filter(p=>!currentUser || p.city.toLowerCase()===currentUser.city.toLowerCase());

  return [...registered,...samples];
}

function renderPeople(list=getPeople()) {
  const grid=document.getElementById("peopleGrid");

  grid.innerHTML="";

  if(!list.length) {
    grid.innerHTML='<div class="empty">No profiles found. Try another filter.</div>';
    return;
  }

  list.forEach(person=>{
    const card=document.createElement("div");
    card.className="card";

    const image=document.createElement("img");
    image.className="profile-image";
    image.alt="Member profile photo";
    image.src=person.photo||"https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=600";

    const content=document.createElement("div");
    content.className="card-content";

    const title=document.createElement("h3");
    title.textContent=person.name+", "+person.age;

    const bio=document.createElement("p");
    bio.textContent=person.bio||"Getting to know new people.";

    const location=document.createElement("div");
    location.className="distance";
    location.textContent="📍 "+(person.area||"Nearby area")+", "+person.city+" • "+(person.distance||"Distance unavailable");

    const tag=document.createElement("span");
    tag.className="tag";
    tag.textContent=person.interest||"Social";

    const actions=document.createElement("div");
    actions.className="card-actions";

    const connect=document.createElement("button");
    connect.className="primary";
    connect.textContent="Connect";
    connect.onclick=()=>requireAccount("Sign in to connect with members.");

    const report=document.createElement("button");
    report.className="secondary";
    report.textContent="Report";
    report.onclick=()=>reportMember(person.id);

    actions.append(connect,report);

    content.append(title,bio,location,tag,actions);
    card.append(image,content);

    grid.appendChild(card);
  });
}

function filterPeople(category,button) {
  document.querySelectorAll(".category").forEach(btn=>{
    btn.classList.remove("active");
  });

  button.classList.add("active");

  let list=getPeople();

  if(category!=="All") {
    list=list.filter(person=>person.interest===category);
  }

  renderPeople(list);
}

/* BLOCK AND REPORT */

function reportMember(id) {
  if(!currentUser) {
    requireAccount("Login to report a member.");
    return;
  }

  const reason=prompt("Briefly describe the reason for reporting this profile:");

  if(!reason?.trim()) return;

  notify("Report recorded in this demonstration. A live moderation system is required for review.");
}

function requireAccount(message) {
  if(!currentUser) {
    notify(message);
    openModal("authModal");
    return false;
  }

  return true;
}

/* MEETUPS */

function renderMeetups() {
  const grid=document.getElementById("meetupGrid");

  grid.innerHTML="";

  const upcoming=meetups.filter(event=>{
    return event.date>=today;
  });

  if(!upcoming.length) {
    grid.innerHTML='<div class="empty">No upcoming meetups yet. Create the first one!</div>';
    return;
  }

  upcoming.forEach(event=>{
    const card=document.createElement("div");
    card.className="card meetup-card";

    const title=document.createElement("h3");
    title.textContent=event.name;

    const info=document.createElement("div");
    info.className="meetup-info";

    info.textContent=
      "📍 "+event.location+
      "\n📅 "+event.date+
      "\n⏰ "+event.time+
      "\n🥤 "+event.type+
      "\n👥 "+(event.attendees?.length||0)+" / "+event.capacity+" attending"+
      "\n👤 Hosted by: "+event.host;

    const description=document.createElement("p");
    description.textContent=event.description||"Come and socialize.";

    const button=document.createElement("button");
    button.className="primary";
    button.textContent=event.attendees?.includes(currentUser?.id)?"Cancel RSVP":"I'm Interested";

    button.onclick=()=>rsvp(event.id);

    card.append(title,info,description,button);
    grid.appendChild(card);
  });
}

function rsvp(id) {
  if(!requireAccount("Login to RSVP to a meetup.")) return;

  const event=meetups.find(e=>e.id===id);

  if(!event) return;

  event.attendees=event.attendees||[];

  if(event.attendees.includes(currentUser.id)) {
    event.attendees=event.attendees.filter(id=>id!==currentUser.id);
    notify("Your RSVP has been cancelled.");
  } else {
    if(event.attendees.length>=event.capacity) {
      notify("This meetup is full.");
      return;
    }

    event.attendees.push(currentUser.id);
    notify("You're interested in this meetup!");
  }

  save(STORAGE.meetups,meetups);
  renderMeetups();
}

/* CREATE MEETUP */

document.getElementById("meetupForm").addEventListener("submit",function(e) {
  e.preventDefault();

  if(!requireAccount("Create an account to publish a meetup.")) return;

  const date=document.getElementById("eventDate").value;
  const time=document.getElementById("eventTime").value;

  if(date<today) {
    notify("Choose a future date.");
    return;
  }

  if(date===today && time<=new Date().toTimeString().slice(0,5)) {
    notify("Choose a future meeting time.");
    return;
  }

  const capacity=Number(document.getElementById("eventCapacity").value);

  if(capacity<2 || capacity>100) {
    notify("Choose a capacity between 2 and 100.");
    return;
  }

  const event={
    id:crypto.randomUUID(),
    name:document.getElementById("eventName").value.trim(),
    location:document.getElementById("eventLocation").value.trim(),
    date:date,
    time:time,
    type:document.getElementById("eventType").value,
    capacity:capacity,
    description:document.getElementById("eventDescription").value.trim(),
    attendees:[currentUser.id],
    host:currentUser.name
  };

  meetups.unshift(event);

  if(!save(STORAGE.meetups,meetups)) {
    meetups.shift();
    return;
  }

  this.reset();

  renderMeetups();

  notify("Your meetup has been published!");
});

/* ACCOUNT INTERFACE */

function updateAccountArea() {
  const area=document.getElementById("accountArea");
  const profileArea=document.getElementById("profileArea");

  if(currentUser) {
    area.innerHTML=`
      <div class="user-bar">
        <span>${escapeHTML(currentUser.name)}</span>
        <button class="secondary" onclick="goTo('profileArea')">My Account</button>
      </div>
    `;

    profileArea.style.display="block";
  } else {
    area.innerHTML=`
      <button class="primary" onclick="openModal('authModal')">
        Join / Login
      </button>
    `;

    profileArea.style.display="none";
  }
}

/* INITIALIZE */

function refresh() {
  updateAccountArea();
  renderMyProfile();
  renderPeople();
  renderMeetups();
}

refresh();

/* DATE RESTRICTIONS */

document.getElementById("eventDate").min=today;

</script>

</body>
</html>
